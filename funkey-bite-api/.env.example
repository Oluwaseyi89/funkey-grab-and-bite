# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=funkey_grab_bite
DB_SSLMODE=disable

# Database Connection Pool Settings (Defaults are adaptive if running in Lambda)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Server Configuration
PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENVIRONMENT=development

# Extra CORS origins (comma-separated) on top of localhost and funkeygrabandbite.com.
# One "*" wildcard per entry matches Vercel preview URLs, e.g. https://my-app-*.vercel.app
CORS_ALLOWED_ORIGINS=

# Email Configuration
AWS_REGION=us-east-1
SES_SENDER_EMAIL=orders@funkeygrabandbite.com
APP_URL=https://funkeygrabandbite.com

# SMS Configuration (Termii — https://developers.termii.com/messaging-api)
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=your_termii_sender_id
# Optional overrides — sane defaults are baked in if unset:
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_CHANNEL=dnd

# Payment Configuration (Paystack — https://docs-v2.paystack.com/docs/api/charge)
PAYSTACK_SECRET_KEY=your_paystack_secret_key
# Optional override — defaults to https://api.paystack.co if unset:
# PAYSTACK_BASE_URL=https://api.paystack.co

# Default Admin Bootstrap (required when admin_users is empty)
DEFAULT_ADMIN_EMAIL=admin+change-me@funkeygrabandbite.com
DEFAULT_ADMIN_USERNAME=admin_change_me
DEFAULT_ADMIN_PASSWORD=change-this-to-a-strong-password
DEFAULT_ADMIN_ROLE=admin
# Static file storage for menu images (S3-compatible). Leave STORAGE_PROVIDER
# empty to disable uploads; set it to "supabase" or "s3" and fill in the rest.
# The database stores object keys (e.g. menu-items/<id>.webp), so moving between
# providers only means copying the bucket and changing these values.
STORAGE_PROVIDER=
# supabase: https://<project-ref>.supabase.co/storage/v1/s3 (optional for s3)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
# Server-side only; never expose these to the admin or web apps.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# supabase: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
# s3: https://<bucket>.s3.<region>.amazonaws.com or a CloudFront domain
STORAGE_PUBLIC_BASE_URL=

# IANA timezone the business opening hours are written in. Servers usually run
# in UTC, so open/closed checks convert to this zone first. Defaults to
# Africa/Lagos when unset.
BUSINESS_TIMEZONE=Africa/Lagos
