# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=funkey_grab_bite
DB_SSLMODE=disable

# Database Connection Pool Settings (Defaults are adaptive if running in Lambda)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Server Configuration
PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENVIRONMENT=development

# Email Configuration
AWS_REGION=us-east-1
SES_SENDER_EMAIL=orders@funkeygrabandbite.com
APP_URL=https://funkeygrabandbite.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Default Admin Bootstrap (required when admin_users is empty)
DEFAULT_ADMIN_EMAIL=admin+change-me@funkeygrabandbite.com
DEFAULT_ADMIN_USERNAME=admin_change_me
DEFAULT_ADMIN_PASSWORD=change-this-to-a-strong-password
DEFAULT_ADMIN_ROLE=admin