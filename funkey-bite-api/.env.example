# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=funkey_grab_bite
DB_SSLMODE=disable

# Database Connection Pool Settings (Defaults are adaptive if running in Lambda)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# Server Configuration
PORT=8080
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENVIRONMENT=development

# Email Configuration
AWS_REGION=us-east-1
SES_SENDER_EMAIL=orders@funkeygrabandbite.com
APP_URL=https://funkeygrabandbite.com

# SMS Configuration (Termii — https://developers.termii.com/messaging-api)
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=your_termii_sender_id
# Optional overrides — sane defaults are baked in if unset:
# TERMII_BASE_URL=https://api.ng.termii.com
# TERMII_CHANNEL=dnd

# Payment Configuration (Paystack — https://docs-v2.paystack.com/docs/api/charge)
PAYSTACK_SECRET_KEY=your_paystack_secret_key
# Optional override — defaults to https://api.paystack.co if unset:
# PAYSTACK_BASE_URL=https://api.paystack.co

# Default Admin Bootstrap (required when admin_users is empty)
DEFAULT_ADMIN_EMAIL=admin+change-me@funkeygrabandbite.com
DEFAULT_ADMIN_USERNAME=admin_change_me
DEFAULT_ADMIN_PASSWORD=change-this-to-a-strong-password
DEFAULT_ADMIN_ROLE=admin