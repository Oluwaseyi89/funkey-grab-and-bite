    "/api/v1/admin/inventory/stock": {"patch": {"operationId": "updateInventoryStock", "summary": "Update inventory stock", "responses": {"200": {"description": "Updated inventory item"}}}},
    "/api/v1/admin/inventory/restock": {"post": {"operationId": "restockInventoryItem", "summary": "Restock inventory item", "responses": {"200": {"description": "Restocked inventory item"}}}},
    "/api/v1/admin/inventory/alerts": {"get": {"operationId": "getInventoryAlerts", "summary": "Get inventory alerts", "responses": {"200": {"description": "Inventory alerts"}}}},
    "/api/v1/admin/catering/requests": {"get": {"operationId": "getAdminCateringRequests", "summary": "List catering requests", "responses": {"200": {"description": "Paginated catering requests"}}}},
