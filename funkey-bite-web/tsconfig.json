{
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "nuxt"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "nuxt.config.ts",
    "plugins/**/*.ts",
    "stores/**/*.ts",
    "composables/**/*.ts",
    "types/**/*.ts"
  ]
}














